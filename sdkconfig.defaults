# ESP-IDF 5.5.3, target esp32c3. Do not enable PSRAM, Bluetooth, or Wi-Fi.
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ is left at the IDF default. The value that
# landed in sdkconfig is recorded in docs/benchmarks/ as a build setting,
# not as a runtime measurement.

CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Keep the image header at 8 MB so merge-bin does not depend on a live chip.
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CONFIG_BT_ENABLED is not set
# ESP-IDF 5.5.3's ESP_WIFI_ENABLED has no Kconfig prompt and defaults on for
# esp32c3, so this file cannot clear it. The app never calls esp_wifi_init;
# the linked image does not contain that symbol.

# app_main holds the frame loop, mbedtls, and the LCD flush. The Peanut
# instance itself is heap-allocated, not on this stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
